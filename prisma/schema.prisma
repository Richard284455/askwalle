// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ResourceType {
  news
  review
  prompt
  skill
  tutorial
}

enum ResourceStatus {
  draft
  published
  archived
}

enum ResourceSourceType {
  original
  source_informed
  external
}

enum ToolTagKind {
  platform
  pricing
  topic
}

enum RewriteStatus {
  raw_imported
  draft_generated
  human_reviewed
}

enum ToolLinkKind {
  twitter
  facebook
  instagram
  youtube
  linkedin
  tiktok
  github
  discord
  reddit
  pinterest
  email
  pricing
  login
  signup
  about
  contact
  other
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("settings")
  @@index([key])
}

model Website {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String
  slug        String?  @unique
  category    Category @relation(fields: [category_id], references: [id])
  category_id Int
  thumbnail   String?
  thumbnail_base64 String?
  status      String   @default("pending")
  visits      Int      @default(0)
  likes       Int      @default(0)
  active      Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  toolDetail  ToolDetail?
  toolTags    WebsiteToolTag[]
  toolLinks   ToolLink[]
  toolMedia   ToolMedia[]
  toolFaqs    ToolFAQ[]

  @@map("websites")
  @@index([category_id])
  @@index([status])
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  parent_id  Int?
  parent     Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  websites   Website[]

  @@map("categories")
  @@index([slug])
  @@index([parent_id])
}

model FooterLink {
  id         Int      @id @default(autoincrement())
  title      String   // 链接标题
  url        String   @unique // 链接地址
  isExternal Boolean  @default(true) // 是否为外部链接
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("footer_links")
  @@index([url])
}

model ResourceContent {
  id             Int                @id @default(autoincrement())
  type           ResourceType
  slug           String
  title          String
  summary        String
  category       String
  tags           Json
  publishedAt    DateTime
  updatedAt      DateTime           @updatedAt
  status         ResourceStatus     @default(draft)
  sourceType     ResourceSourceType @default(original)
  sources        Json?
  content        Json
  seoTitle       String?
  seoDescription String?

  @@map("resource_contents")
  @@unique([type, slug])
  @@index([type, status, publishedAt])
  @@index([category])
}

model ToolDetail {
  id               Int       @id @default(autoincrement())
  website_id       Int       @unique
  website          Website   @relation(fields: [website_id], references: [id])
  what             String?
  how              String?
  features_text    String?
  features         Json?
  use_cases        Json?
  rating           Float?
  review_count     Int       @default(0)
  saved_count      Int       @default(0)
  monthly_visitors Int?
  listed_at        DateTime?
  source           String?
  external_raw     String?
  raw_imported_content Json?          // 原始导入底稿快照（仅内部）
  ai_rewrite_draft     Json?          // AI 改写草稿（仅内部，人工审核前不公开）
  rewrite_status       RewriteStatus? // raw_imported / draft_generated / human_reviewed
  reviewed_at          DateTime?
  review_notes         String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("tool_details")
}

model ToolTag {
  id       Int              @id @default(autoincrement())
  name     String
  slug     String           @unique
  kind     ToolTagKind
  websites WebsiteToolTag[]

  @@map("tool_tags")
  @@unique([kind, name])
}

model WebsiteToolTag {
  website_id Int
  tag_id     Int
  website    Website @relation(fields: [website_id], references: [id])
  tag        ToolTag @relation(fields: [tag_id], references: [id])

  @@map("website_tool_tags")
  @@id([website_id, tag_id])
  @@index([tag_id])
}

model ToolLink {
  id         Int          @id @default(autoincrement())
  website_id Int
  website    Website      @relation(fields: [website_id], references: [id])
  kind       ToolLinkKind
  url        String
  label      String?
  created_at DateTime     @default(now())

  @@map("tool_links")
  @@unique([website_id, kind, url])
  @@index([website_id])
}

model ToolMedia {
  id         Int      @id @default(autoincrement())
  website_id Int
  website    Website  @relation(fields: [website_id], references: [id])
  kind       String   @default("screenshot")
  // V1 存提取出来的源图 URL；TODO: 后续缓存到 public/ 或对象存储，不长期热链外部 CDN
  url        String
  alt        String?
  position   Int      @default(0)
  created_at DateTime @default(now())

  @@map("tool_media")
  @@index([website_id])
}

model ToolFAQ {
  id         Int     @id @default(autoincrement())
  website_id Int
  website    Website @relation(fields: [website_id], references: [id])
  question   String
  answer     String?
  position   Int     @default(0)

  @@map("tool_faqs")
  @@index([website_id])
}
