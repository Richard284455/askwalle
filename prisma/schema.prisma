// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ResourceType {
  news
  review
  prompt
  skill
  tutorial
}

enum ResourceStatus {
  draft
  published
  archived
}

enum ResourceSourceType {
  original
  source_informed
  external
}

enum ToolTagKind {
  platform
  pricing
  topic
}

enum RewriteStatus {
  raw_imported
  draft_generated
  human_reviewed
}

enum ToolLinkKind {
  twitter
  facebook
  instagram
  youtube
  linkedin
  tiktok
  github
  discord
  reddit
  pinterest
  email
  pricing
  login
  signup
  about
  contact
  other
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("settings")
  @@index([key])
}

model Website {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String
  slug        String?  @unique
  category    Category @relation(fields: [category_id], references: [id])
  category_id Int
  import_batch_id Int?
  thumbnail   String?
  thumbnail_base64 String?
  status      String   @default("pending")
  visits      Int      @default(0)
  likes       Int      @default(0)
  active      Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  toolDetail  ToolDetail?
  toolTags    WebsiteToolTag[]
  toolLinks   ToolLink[]
  toolMedia   ToolMedia[]
  toolFaqs    ToolFAQ[]
  rewriteItems ToolRewriteItem[]

  @@map("websites")
  @@index([category_id])
  @@index([status])
  @@index([import_batch_id])
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String
  slug       String    @unique
  parent_id  Int?
  parent     Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  websites   Website[]

  @@map("categories")
  @@index([slug])
  @@index([parent_id])
}

model FooterLink {
  id         Int      @id @default(autoincrement())
  title      String   // 链接标题
  url        String   @unique // 链接地址
  isExternal Boolean  @default(true) // 是否为外部链接
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("footer_links")
  @@index([url])
}

model ResourceContent {
  id             Int                @id @default(autoincrement())
  type           ResourceType
  slug           String
  title          String
  summary        String
  category       String
  tags           Json
  publishedAt    DateTime
  updatedAt      DateTime           @updatedAt
  status         ResourceStatus     @default(draft)
  sourceType     ResourceSourceType @default(original)
  sources        Json?
  content        Json
  seoTitle       String?
  seoDescription String?

  @@map("resource_contents")
  @@unique([type, slug])
  @@index([type, status, publishedAt])
  @@index([category])
}

model ToolDetail {
  id               Int       @id @default(autoincrement())
  website_id       Int       @unique
  website          Website   @relation(fields: [website_id], references: [id])
  what             String?
  how              String?
  features_text    String?
  features         Json?
  use_cases        Json?
  rating           Float?
  review_count     Int       @default(0)
  saved_count      Int       @default(0)
  monthly_visitors Int?
  listed_at        DateTime?
  source           String?
  external_raw     String?
  raw_imported_content Json?          // 原始导入底稿快照（仅内部）
  ai_rewrite_draft     Json?          // AI 改写草稿（仅内部，人工审核前不公开）
  rewrite_status       RewriteStatus? // raw_imported / draft_generated / human_reviewed
  reviewed_at          DateTime?
  review_notes         String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("tool_details")
}

model ToolTag {
  id       Int              @id @default(autoincrement())
  name     String
  slug     String           @unique
  kind     ToolTagKind
  websites WebsiteToolTag[]

  @@map("tool_tags")
  @@unique([kind, name])
}

model WebsiteToolTag {
  website_id Int
  tag_id     Int
  website    Website @relation(fields: [website_id], references: [id])
  tag        ToolTag @relation(fields: [tag_id], references: [id])

  @@map("website_tool_tags")
  @@id([website_id, tag_id])
  @@index([tag_id])
}

model ToolLink {
  id         Int          @id @default(autoincrement())
  website_id Int
  website    Website      @relation(fields: [website_id], references: [id])
  kind       ToolLinkKind
  url        String
  label      String?
  created_at DateTime     @default(now())

  @@map("tool_links")
  @@unique([website_id, kind, url])
  @@index([website_id])
}

model ToolMedia {
  id         Int      @id @default(autoincrement())
  website_id Int
  website    Website  @relation(fields: [website_id], references: [id])
  kind       String   @default("screenshot")
  // V1 存提取出来的源图 URL；发布前由 tool-media-cache 本地化（url 保留不动）
  url        String
  alt        String?
  position   Int      @default(0)
  created_at DateTime @default(now())

  // 媒体本地化（纯加法字段）：公开页优先 local_url，其次 url
  original_url String?
  local_url    String?
  cache_status String? // pending / cached / failed / skipped
  cache_error  String?
  cached_at    DateTime?

  @@map("tool_media")
  @@index([website_id])
}

model ToolImportBatch {
  id             Int              @id @default(autoincrement())
  name           String?
  source_dir     String?
  file_count     Int              @default(0)
  row_count      Int              @default(0)
  imported_count Int              @default(0)
  skipped_count  Int              @default(0)
  error_count    Int              @default(0)
  started_at     DateTime         @default(now())
  finished_at    DateTime?
  files          ToolImportFile[]

  @@map("tool_import_batches")
}

model ToolImportFile {
  id              Int             @id @default(autoincrement())
  batch_id        Int
  batch           ToolImportBatch @relation(fields: [batch_id], references: [id])
  file_path       String
  file_name       String
  row_count       Int             @default(0)
  imported_count  Int             @default(0)
  skipped_count   Int             @default(0)
  error_count     Int             @default(0)
  error_log       String?
  level1_category String?
  level2_category String?
  created_at      DateTime        @default(now())

  @@map("tool_import_files")
  @@index([batch_id])
}

model AIProviderConfig {
  id                   Int       @id @default(autoincrement())
  provider_key         String    @unique // openai / deepseek / qwen / kimi / custom
  display_name         String?
  enabled              Boolean   @default(true)
  base_url             String?
  encrypted_api_key    String?   // AES-256-GCM 密文，绝不明文
  api_key_last4        String?
  api_key_source       String?   // env / db / missing（保存时记录，展示以运行时解析为准）
  default_model        String?
  model_presets        Json?     // string[] 模型 ID 列表
  supports_batch       Boolean   @default(false)
  supports_direct      Boolean   @default(true)
  supports_json_schema Boolean   @default(false)
  notes                String?
  last_tested_at       DateTime?
  last_test_status     String?
  last_test_error      String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@map("ai_provider_configs")
}

model ToolRewriteBatch {
  id              Int               @id @default(autoincrement())
  name            String?
  provider        String            @default("openai")
  model           String
  status          String            @default("created") // created / jsonl_generated / submitted / in_progress / completed / failed / imported
  filter_snapshot Json?
  total_count     Int               @default(0)
  submitted_count Int               @default(0)
  completed_count Int               @default(0)
  failed_count    Int               @default(0)
  qc_passed_count Int               @default(0)
  qc_failed_count Int               @default(0)
  openai_batch_id String?
  input_file_id   String?
  output_file_id  String?
  error_file_id   String?
  submitted_at    DateTime?
  completed_at    DateTime?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  items           ToolRewriteItem[]

  @@map("tool_rewrite_batches")
}

model ToolRewriteItem {
  id            Int              @id @default(autoincrement())
  batch_id      Int
  batch         ToolRewriteBatch @relation(fields: [batch_id], references: [id])
  website_id    Int
  website       Website          @relation(fields: [website_id], references: [id])
  status        String           @default("queued") // queued / submitted / completed / failed / qc_failed / saved
  custom_id     String           @unique
  prompt        String?
  raw_output    Json?
  parsed_draft  Json?
  qc_status     String?
  qc_errors     Json?
  error_message String?
  attempt_count Int              @default(0)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  @@map("tool_rewrite_items")
  @@index([batch_id])
  @@index([website_id])
}

model ToolFAQ {
  id         Int     @id @default(autoincrement())
  website_id Int
  website    Website @relation(fields: [website_id], references: [id])
  question   String
  answer     String?
  position   Int     @default(0)

  @@map("tool_faqs")
  @@index([website_id])
}

// 通用后台批量任务（异步化长操作：apply&review / publish 等；分块执行 + 进度）
model BulkJob {
  id                      Int           @id @default(autoincrement())
  type                    String // import_excel / rewrite_direct / apply_drafts / apply_and_review / mark_reviewed / publish / media_cache
  status                  String        @default("queued") // queued / running / completed / completed_with_errors / failed / canceled
  total_count             Int           @default(0)
  processed_count         Int           @default(0)
  success_count           Int           @default(0)
  skipped_count           Int           @default(0)
  failed_count            Int           @default(0)
  // QC 未通过（模型答了但内容不合格）与 failed（请求本身失败）分开记账
  qc_failed_count         Int           @default(0)
  params                  Json?
  result                  Json?
  error                   Json?
  related_import_batch_id  Int?
  related_rewrite_batch_id Int?
  // 任务级租约：同一时刻只让一个 worker 推进该任务（多实例部署时收敛 provider 并发）
  locked_by               String?
  locked_until            DateTime?
  created_at              DateTime      @default(now())
  started_at              DateTime?
  finished_at             DateTime?
  updated_at              DateTime      @updatedAt
  items                   BulkJobItem[]

  @@map("bulk_jobs")
  @@index([type, status])
}

model BulkJobItem {
  id         Int      @id @default(autoincrement())
  job_id     Int
  job        BulkJob  @relation(fields: [job_id], references: [id])
  website_id Int?
  status     String   @default("queued") // queued / running / success / skipped / failed
  result     Json?
  error      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("bulk_job_items")
  @@index([job_id, status])
  @@index([website_id])
}
