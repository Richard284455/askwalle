// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ResourceType {
  news
  review
  prompt
  skill
  tutorial
}

enum ResourceStatus {
  draft
  published
  archived
}

enum ResourceSourceType {
  original
  source_informed
  external
}

enum ToolTagKind {
  platform
  pricing
  topic
}

enum RewriteStatus {
  raw_imported
  draft_generated
  human_reviewed
}

enum ToolLinkKind {
  twitter
  facebook
  instagram
  youtube
  linkedin
  tiktok
  github
  discord
  reddit
  pinterest
  email
  pricing
  login
  signup
  about
  contact
  other
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([key])
  @@map("settings")
}

model Website {
  id               Int                 @id @default(autoincrement())
  title            String
  url              String
  description      String
  slug             String?             @unique
  category         Category            @relation(fields: [category_id], references: [id])
  category_id      Int
  import_batch_id  Int?
  thumbnail        String?
  thumbnail_base64 String?
  status           String              @default("pending")
  visits           Int                 @default(0)
  likes            Int                 @default(0)
  active           Int                 @default(1)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  toolDetail       ToolDetail?
  toolTags         WebsiteToolTag[]
  toolLinks        ToolLink[]
  toolMedia        ToolMedia[]
  toolFaqs         ToolFAQ[]
  rewriteItems     ToolRewriteItem[]
  lifecycleState   ToolLifecycleState?
  healthEvents     ToolHealthEvent[]

  @@index([category_id])
  @@index([status])
  @@index([import_batch_id])
  @@map("websites")
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  parent_id  Int?
  parent     Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  websites   Website[]

  @@index([slug])
  @@index([parent_id])
  @@map("categories")
}

model FooterLink {
  id         Int      @id @default(autoincrement())
  title      String // 链接标题
  url        String   @unique // 链接地址
  isExternal Boolean  @default(true) // 是否为外部链接
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([url])
  @@map("footer_links")
}

model ResourceContent {
  id             Int                @id @default(autoincrement())
  type           ResourceType
  slug           String
  title          String
  summary        String
  category       String
  tags           Json
  publishedAt    DateTime
  updatedAt      DateTime           @updatedAt
  status         ResourceStatus     @default(draft)
  sourceType     ResourceSourceType @default(original)
  sources        Json?
  content        Json
  seoTitle       String?
  seoDescription String?

  @@unique([type, slug])
  @@index([type, status, publishedAt])
  @@index([category])
  @@map("resource_contents")
}

model ToolDetail {
  id                   Int            @id @default(autoincrement())
  website_id           Int            @unique
  website              Website        @relation(fields: [website_id], references: [id])
  what                 String?
  how                  String?
  features_text        String?
  features             Json?
  use_cases            Json?
  rating               Float?
  review_count         Int            @default(0)
  saved_count          Int            @default(0)
  monthly_visitors     Int?
  listed_at            DateTime?
  source               String?
  external_raw         String?
  raw_imported_content Json? // 原始导入底稿快照（仅内部）
  ai_rewrite_draft     Json? // AI 改写草稿（仅内部，人工审核前不公开）
  rewrite_status       RewriteStatus? // raw_imported / draft_generated / human_reviewed
  reviewed_at          DateTime?
  review_notes         String?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@map("tool_details")
}

model ToolTag {
  id       Int              @id @default(autoincrement())
  name     String
  slug     String           @unique
  kind     ToolTagKind
  websites WebsiteToolTag[]

  @@unique([kind, name])
  @@map("tool_tags")
}

model WebsiteToolTag {
  website_id Int
  tag_id     Int
  website    Website @relation(fields: [website_id], references: [id])
  tag        ToolTag @relation(fields: [tag_id], references: [id])

  @@id([website_id, tag_id])
  @@index([tag_id])
  @@map("website_tool_tags")
}

model ToolLink {
  id         Int          @id @default(autoincrement())
  website_id Int
  website    Website      @relation(fields: [website_id], references: [id])
  kind       ToolLinkKind
  url        String
  label      String?
  created_at DateTime     @default(now())

  @@unique([website_id, kind, url])
  @@index([website_id])
  @@map("tool_links")
}

model ToolMedia {
  id         Int      @id @default(autoincrement())
  website_id Int
  website    Website  @relation(fields: [website_id], references: [id])
  kind       String   @default("screenshot")
  // V1 存提取出来的源图 URL；发布前由 tool-media-cache 本地化（url 保留不动）
  url        String
  alt        String?
  position   Int      @default(0)
  created_at DateTime @default(now())

  // 媒体本地化（纯加法字段）：公开页优先 local_url，其次 url
  original_url String?
  local_url    String?
  cache_status String? // pending / cached / failed / skipped
  cache_error  String?
  cached_at    DateTime?

  @@index([website_id])
  @@map("tool_media")
}

model ToolImportBatch {
  id             Int              @id @default(autoincrement())
  name           String?
  source_dir     String?
  file_count     Int              @default(0)
  row_count      Int              @default(0)
  imported_count Int              @default(0)
  skipped_count  Int              @default(0)
  error_count    Int              @default(0)
  started_at     DateTime         @default(now())
  finished_at    DateTime?
  files          ToolImportFile[]

  @@map("tool_import_batches")
}

model ToolImportFile {
  id              Int             @id @default(autoincrement())
  batch_id        Int
  batch           ToolImportBatch @relation(fields: [batch_id], references: [id])
  file_path       String
  file_name       String
  row_count       Int             @default(0)
  imported_count  Int             @default(0)
  skipped_count   Int             @default(0)
  error_count     Int             @default(0)
  error_log       String?
  level1_category String?
  level2_category String?
  created_at      DateTime        @default(now())

  @@index([batch_id])
  @@map("tool_import_files")
}

model AIProviderConfig {
  id                   Int       @id @default(autoincrement())
  provider_key         String    @unique // openai / deepseek / qwen / kimi / custom
  display_name         String?
  enabled              Boolean   @default(true)
  base_url             String?
  encrypted_api_key    String? // AES-256-GCM 密文，绝不明文
  api_key_last4        String?
  api_key_source       String? // env / db / missing（保存时记录，展示以运行时解析为准）
  default_model        String?
  model_presets        Json? // string[] 模型 ID 列表
  supports_batch       Boolean   @default(false)
  supports_direct      Boolean   @default(true)
  supports_json_schema Boolean   @default(false)
  notes                String?
  last_tested_at       DateTime?
  last_test_status     String?
  last_test_error      String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@map("ai_provider_configs")
}

model ToolRewriteBatch {
  id              Int               @id @default(autoincrement())
  name            String?
  provider        String            @default("openai")
  model           String
  status          String            @default("created") // created / jsonl_generated / submitted / in_progress / completed / failed / imported
  filter_snapshot Json?
  total_count     Int               @default(0)
  submitted_count Int               @default(0)
  completed_count Int               @default(0)
  failed_count    Int               @default(0)
  qc_passed_count Int               @default(0)
  qc_failed_count Int               @default(0)
  openai_batch_id String?
  input_file_id   String?
  output_file_id  String?
  error_file_id   String?
  submitted_at    DateTime?
  completed_at    DateTime?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  items           ToolRewriteItem[]

  @@map("tool_rewrite_batches")
}

model ToolRewriteItem {
  id            Int              @id @default(autoincrement())
  batch_id      Int
  batch         ToolRewriteBatch @relation(fields: [batch_id], references: [id])
  website_id    Int
  website       Website          @relation(fields: [website_id], references: [id])
  status        String           @default("queued") // queued / submitted / completed / failed / qc_failed / saved
  custom_id     String           @unique
  prompt        String?
  raw_output    Json?
  parsed_draft  Json?
  qc_status     String?
  qc_errors     Json?
  error_message String?
  attempt_count Int              @default(0)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  @@index([batch_id])
  @@index([website_id])
  @@map("tool_rewrite_items")
}

model ToolFAQ {
  id         Int     @id @default(autoincrement())
  website_id Int
  website    Website @relation(fields: [website_id], references: [id])
  question   String
  answer     String?
  position   Int     @default(0)

  @@index([website_id])
  @@map("tool_faqs")
}

// 通用后台批量任务（异步化长操作：apply&review / publish 等；分块执行 + 进度）
model BulkJob {
  id                       Int           @id @default(autoincrement())
  type                     String // import_excel / rewrite_direct / apply_drafts / apply_and_review / mark_reviewed / publish / media_cache
  status                   String        @default("queued") // queued / running / completed / completed_with_errors / failed / canceled
  total_count              Int           @default(0)
  processed_count          Int           @default(0)
  success_count            Int           @default(0)
  skipped_count            Int           @default(0)
  failed_count             Int           @default(0)
  // QC 未通过（模型答了但内容不合格）与 failed（请求本身失败）分开记账
  qc_failed_count          Int           @default(0)
  params                   Json?
  result                   Json?
  error                    Json?
  related_import_batch_id  Int?
  related_rewrite_batch_id Int?
  // 任务级租约：同一时刻只让一个 worker 推进该任务（多实例部署时收敛 provider 并发）
  locked_by                String?
  locked_until             DateTime?
  created_at               DateTime      @default(now())
  started_at               DateTime?
  finished_at              DateTime?
  updated_at               DateTime      @updatedAt
  items                    BulkJobItem[]

  @@index([type, status])
  @@map("bulk_jobs")
}

model BulkJobItem {
  id         Int            @id @default(autoincrement())
  job_id     Int
  job        BulkJob        @relation(fields: [job_id], references: [id])
  website_id Int?
  // 内容采集任务的条目指向信息源而不是工具（与 website_id 互斥，同为可空）
  source_id  Int?
  source     ContentSource? @relation(fields: [source_id], references: [id])
  status     String         @default("queued") // queued / running / success / skipped / failed
  result     Json?
  error      String?
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@index([job_id, status])
  @@index([website_id])
  @@index([source_id])
  @@map("bulk_job_items")
}

// ---------------------------------------------------------------------------
// 工具生命周期（P0a：只做可达性，不影响公开页）
//
// 与 Website.status / ToolDetail.rewrite_status 正交：那两个记「编辑流程走到哪」，
// 这里记「站点还活着吗、内容还新吗」。混在一起会让状态空间爆炸并破坏现有 guard。
// ---------------------------------------------------------------------------

model ToolLifecycleState {
  website_id Int     @id
  website    Website @relation(fields: [website_id], references: [id])

  // ── 分层 ──
  tier        String  @default("standard") // featured / standard / longtail
  tier_locked Boolean @default(false) // 人工锁定，不被自动分层覆盖

  // ── 可达性 ──
  reach           String    @default("unknown") // ok / dead / unverifiable / unknown
  reach_since     DateTime?
  last_ok_at      DateTime?
  last_checked_at DateTime?
  next_check_at   DateTime?

  // ── 消抖输入（契约 §6）──
  consecutive_fails   Int       @default(0)
  distinct_fail_dates Int       @default(0)
  first_fail_at       DateTime?
  last_fail_date      String? // Asia/Shanghai 日期 YYYY-MM-DD，与 cron 时区一致
  fail_family         String? // network / server / gone
  last_error_kind     String?

  // ── 深度内容检查（正文分类）──
  // HEAD 2xx 短路会跳过取正文，正常体积的 soft-404 / 停放页就永远进不了
  // 内容分类。这两个字段驱动「按 tier 周期性强制 GET」，保证每个工具都会
  // 定期被完整看一遍正文。
  last_content_checked_at DateTime?
  next_content_check_at   DateTime?

  // ── 观测线索 ──
  final_url          String? // 跟随重定向后的落地 URL（换域名线索）
  archive_url        String? // 死链时给用户的历史快照入口（P0b 用）
  needs_manual_check Boolean @default(false)
  probe_version      Int? // 最近一次判定所用的分类器版本

  // ── 内容新鲜度（轨道 B 预留，P0a 不写）──
  freshness        String?
  last_snapshot_id Int?
  drift_score      Float?
  drift_fields     Json?
  refresh_batch_id Int?

  human_decision String? // confirmed_dead / url_updated / false_positive
  decided_at     DateTime?
  notes          String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([reach])
  @@index([next_check_at])
  @@index([tier, freshness])
  @@index([needs_manual_check])
  @@map("tool_lifecycle_states")
}

// 每个 scheduled check round 一条。ok 存轻量证据，异常存完整证据。
// 全部字段的存在意义是「离线可重放」——判定层必须能拿历史证据重跑出同样结论。
model ToolHealthEvent {
  id         Int     @id @default(autoincrement())
  website_id Int
  website    Website @relation(fields: [website_id], references: [id])

  // ── 溯源 ──
  round_id      String // {job_id}:{website_id}:{YYYY-MM-DD}
  probe_version Int
  job_id        Int?
  round_date    String // Asia/Shanghai 日期

  // ── 判定 ──
  outcome           String // ok / dns / timeout / tls / http_5xx / http_404 / http_410 / soft_404 / parked / blocked / deferred / unsafe_target / unknown
  error_kind        String?
  error_family      String? // network / server / gone
  evidence_strength String? // strong / weak
  confidence        String   @default("high") // high / low
  change_flags      String[] // domain_migrated / recovered / state_changed / needs_manual_check / archive_found
  reach_from        String?
  reach_to          String?

  // ── 轻量证据（每轮都存）──
  final_status    Int?
  final_url       String?
  latency_ms      Int?
  content_verdict String? // normal / spa_shell / non_html / truncated / undecodable

  // ── 完整证据（仅异常/状态变化）──
  evidence Json?

  created_at DateTime @default(now())

  // round_id 是确定性幂等键：worker 回收后重跑同一轮，必须被数据库挡下来，
  // 而不是写第二条事件、再把消抖计数加一次。
  @@unique([round_id])
  @@index([website_id, created_at])
  @@index([created_at])
  @@index([outcome])
  @@map("tool_health_events")
}

// ---------------------------------------------------------------------------
// AI Content Intelligence —— 采集层（第一阶段）
//
// 管道：信息源 → 原始来源条目 → 事件聚类 → 事实与证据 → 编辑草稿 → 人工审核
//       → ResourceContent 发布
// 本阶段只做前两级。往后每一级都建立在「每条事实都能指回某个 SourceItem」之上，
// 所以原始层必须是**不可变的快照**：抓到什么存什么，判断留给上层。
//
// 与 ResourceContent 的关系：ResourceContent 仍是唯一的发布层，这里不替代它，
// 只在它上游补出可追溯的原料。本阶段不写 ResourceContent。
// ---------------------------------------------------------------------------

enum ContentSourceKind {
  rss // RSS / Atom 订阅
  manual // 编辑人工提交的单条 URL
}

/// 来源分级：决定这个源能支撑什么强度的事实主张，以及未来的正文抓取策略
enum ContentSourceTier {
  OFFICIAL_PRIMARY // 第一方官方口径
  STRUCTURED_TECHNICAL // 结构化技术信号（changelog / release / 混合作者博客）
  AUTHORITATIVE_MEDIA // 权威媒体
  COMMUNITY_SIGNAL // 社区信号
}

enum SourceItemStatus {
  fetched // 已抓取，正文快照已落库
  link_only // 只拿到订阅里的元数据，正文抓取失败/未做
  parse_failed // 订阅或正文解析失败，保留原始证据待排查
  duplicate // 与同源的既有条目重复（指向 duplicate_of_id）
}

model ContentSource {
  id              Int                @id @default(autoincrement())
  /// 稳定身份键：feed_url 可能迁移，配置文件与库之间靠这个对齐
  external_key    String?            @unique
  name            String // 展示名，如 "OpenAI Blog"
  kind            ContentSourceKind
  /// 定义文件声明的格式（RSS / ATOM）。解析器会自行探测，两者不符值得报警
  declared_format String?
  source_tier     ContentSourceTier?
  /// RSS 源的订阅地址；manual 源为空
  feed_url        String?
  homepage        String?
  /// 出版方，发布时落到 ResourceContent.sources[].publisher
  publisher       String
  lang            String             @default("en")
  enabled         Boolean            @default(true)

  // 抓取调度（与工具生命周期同一套思路：到期才抓，失败退避）
  fetch_interval_minutes Int       @default(60)
  last_fetched_at        DateTime?
  next_fetch_at          DateTime?
  last_status            String? // ok / not_modified / http_error / parse_error / unsafe_target / dns / timeout ...
  last_error             String?
  consecutive_failures   Int       @default(0)

  // 条件请求：源没更新时回 304，既省流量也是对源站的礼貌
  etag              String?
  last_modified     String?
  /// 跟随重定向后的实际订阅地址；与 feed_url 不同即说明源迁移了，需人工确认后再改配置
  resolved_feed_url String?

  item_count      Int       @default(0)
  /// 最近一次成功（OK / NOT_MODIFIED）的时刻；基础设施故障不得覆盖它
  last_success_at DateTime?
  notes           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items     SourceItem[]
  job_items BulkJobItem[]
  runs      ContentSourceRun[]

  /// 同一个订阅地址只允许配置一次；manual 源 feed_url 为 NULL，Postgres 视 NULL 互不相等，因此不受限
  @@unique([feed_url])
  @@index([enabled, next_fetch_at])
  @@index([kind])
  @@map("content_sources")
}

/// 一次采集尝试的结果分类。区分「源坏了」和「我们这边坏了」是这套分类的全部意义。
enum SourceRunOutcome {
  OK
  NOT_MODIFIED
  PARTIAL_SUCCESS // 抓到了但不完整（如订阅被字节上限截断）
  SOURCE_ERROR // 源侧问题：计入来源失败并退避
  INFRA_ERROR // 我们这边的问题：**不得**归因于源
}

/// 错误归属域。DATABASE / LEASE / INTERNAL 属基础设施，绝不计入来源健康度。
enum SourceRunErrorDomain {
  NONE
  DNS
  NETWORK
  TLS
  HTTP
  ROBOTS
  PARSE
  TRUNCATED
  DATABASE
  LEASE
  INTERNAL
}

/// 每个 source 在每个 job 中的一次采集尝试。
///
/// 建这张表的直接动机：C3 Canary 首轮 AWS 那次「失败」其实是 Supabase 中断，
/// 源根本没被请求，却被记成了来源失败并触发退避 —— 源被冤枉了。
/// 汇总状态说不清这种事，必须逐次留证。
model ContentSourceRun {
  id          Int           @id @default(autoincrement())
  source_id   Int
  source      ContentSource @relation(fields: [source_id], references: [id])
  job_id      Int?
  job_item_id Int?

  started_at  DateTime  @default(now())
  finished_at DateTime?

  outcome      SourceRunOutcome
  error_domain SourceRunErrorDomain @default(NONE)

  // ── 取回证据 ──
  requested_feed_url String
  resolved_feed_url  String?
  http_status        Int?
  bytes_read         Int?
  truncated          Boolean @default(false)
  latency_dns_ms     Int?
  latency_fetch_ms   Int?
  latency_total_ms   Int?
  pinned_ip          String?
  redirect_count     Int?

  // ── 条件请求 ──
  etag_sent              String?
  etag_received          String?
  last_modified_sent     String?
  last_modified_received String?

  // ── 解析结果 ──
  feed_format             String? // rss / atom；解析器实测值
  items_parsed            Int     @default(0)
  items_inserted          Int     @default(0)
  items_duplicate         Int     @default(0)
  items_title_changed     Int     @default(0)
  items_errored           Int     @default(0)
  source_updated_at_count Int     @default(0)

  error_code    String?
  error_message String?
  /// 只放跳转/SSRF/响应/解析元数据。**不存** Cookie、Authorization、
  /// 完整 XML、完整 HTML、第三方正文或任何 secret。
  evidence_json Json?

  created_at DateTime @default(now())

  /// 同一个 job 里同一个源只允许一条有效 run：worker 回收或重复驱动不会写第二条
  @@unique([job_id, source_id])
  @@index([source_id, started_at])
  @@index([outcome, started_at])
  @@index([error_domain, started_at])
  @@map("content_source_runs")
}

model SourceItem {
  id        Int           @id @default(autoincrement())
  source_id Int
  source    ContentSource @relation(fields: [source_id], references: [id])

  // ── 溯源（落库后不再改写）──
  /// 规范化后的原文地址（去跟踪参数、统一大小写与末尾斜杠）
  url           String
  /// 页面自称的 canonical，或订阅里的 <guid>/<id>
  canonical_url String?
  /// url 的 sha256 前 32 位，去重键
  url_hash      String
  /// 正文纯文本的 sha256 前 32 位；用于识别「同内容换地址」，本阶段只记录不判定
  content_hash  String?

  title             String
  author            String?
  /// 来源自称的发布时间（可能缺失或不可信，原样保留）
  published_at      DateTime?
  /// 来源自称的最后修改时间（Atom <updated> / RSS <atom:updated>），用于识别条目被改过
  source_updated_at DateTime?
  fetched_at        DateTime  @default(now())

  // ── 原始快照 ──
  raw_excerpt String? // 订阅里的摘要/description
  raw_content String? // 正文纯文本，截断存储
  lang        String?

  // ── 抓取证据（复用探针的 SSRF 加固取回，逐跳校验）──
  http_status Int?
  final_url   String?
  /// redirectChain / pinnedIp / resolvedIps / latency / bytesRead 等
  evidence    Json?

  status          SourceItemStatus @default(fetched)
  /// 判为重复时指向同源的首条
  duplicate_of_id Int?

  created_at DateTime @default(now())

  /// 同一个源里同一篇文章只记一次。**跨源不去重** —— 「两个源都报道了同一件事」
  /// 是真实的溯源信息，合并成事件是下一阶段聚类要做的judgment，不在原始层预判。
  @@unique([source_id, url_hash])
  @@index([source_id, published_at])
  @@index([status, fetched_at])
  @@index([content_hash])
  @@map("source_items")
}
