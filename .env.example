# Required database configuration
DATABASE_URL=
# PostgreSQL connection string used by Prisma Client at runtime.
# In hosted environments this may be a pooled application connection.

DIRECT_URL=
# PostgreSQL direct/session connection string used for Prisma migrations and local maintenance commands.

# Required authentication configuration
ADMIN_PASSWORD=
# Admin login password. Set manually in .env or deployment environment.

JWT_SECRET=
# Secret used for signing JWT tokens. Generate a strong random value locally.

# Optional object storage / backup configuration
OSS_REGION=
# Object storage region, if backup sync is enabled.

OSS_BUCKET=
# Object storage bucket name, if backup sync is enabled.

OSS_ACCESS_KEY=
# Object storage access key, if backup sync is enabled.

OSS_ACCESS_SECRET=
# Object storage access secret, if backup sync is enabled.

OSS_ENDPOINT=
# Object storage endpoint, if backup sync is enabled.

OSS_DATA_KEY=
# Object storage path/key for backup data, if backup sync is enabled.

BACKUP_ENABLED=
# Set whether scheduled backup behavior is enabled.

BACKUP_INTERVAL=
# Backup interval label used by the existing backup configuration.

BACKUP_RETENTION_DAYS=
# Number of backup retention days.

# Optional analytics configuration
GOOGLE_ANALYTICS=
# Google Analytics ID, if analytics is enabled.

BAIDU_ANALYTICS=
# Baidu Analytics ID, if analytics is enabled.
